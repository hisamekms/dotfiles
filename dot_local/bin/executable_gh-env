#!/bin/bash
# Usage: Set GH_USER in .mise.local.toml, then source this script via _.source
# Example in .mise.local.toml:
#   [env]
#   GH_USER = "hisamekms"
#   _.source = "/Users/username/.local/bin/gh-env"
GH_BIN=$(find "$HOME/.local/share/mise/installs/gh" -name gh -type f 2>/dev/null | head -1)
if [ -n "$GH_BIN" ] && [ -n "$GH_USER" ]; then
  export GH_TOKEN=$("$GH_BIN" auth token --user "$GH_USER")
fi
