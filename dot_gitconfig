[include]
  path = .gitconfig.local
[ghq]
	root = ~/ghq
[core]
	excludesfile = ~/.gitignore_global
[alias]
	graph = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
	psu = push --set-upstream
	ps = push
	pl = pull
	st = status
	c = commit
	cm = commit -m
	aa = add -A
